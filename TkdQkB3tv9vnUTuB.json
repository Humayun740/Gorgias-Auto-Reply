    {
      "parameters": {
        "method": "POST",
        "url": "https://sonic-v8gwc13y.myshopify.com/admin/api/2024-01/graphql.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shopify-Access-Token",
              "value": "shpua_0c08915f04d0b6c6a2d6427674f5c80f"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  (() => {\n    const raw = JSON.parse($json.output[0].content[0].text);\n    const orderNum = raw.order_number;\n    return {\n      query: `query {\n        orders(first: 1, query: \"name:#${orderNum}\") {\n          edges {\n            node {\n              id\n              name\n              displayFulfillmentStatus\n              fulfillments {\n                trackingInfo {\n                  number\n                  url\n                  company\n                }\n              }\n            }\n          }\n        }\n      }`\n    };\n  })()\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        560,
        0
      ],
      "id": "3a3e40aa-9659-414c-80f5-c8d8ac827599",
      "name": "Shopify Live Order Lookup"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "b51936a2-fe04-4046-bce1-db1a0a119040",
              "leftValue": "={{    (() => {     const edges = $json.data?.orders?.edges || [];     if (edges.length === 0) return false;     const order = edges[0].node;     return order.displayFulfillmentStatus === 'FULFILLED' &&             order.fulfillments?.[0]?.trackingInfo?.length > 0;   })() }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
