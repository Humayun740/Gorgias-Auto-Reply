        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an e-commerce support AI. Analyze the customer message.\nExtract:\n1. intent: \"WISMO\" if asking about order status/shipping, else \"OTHER\"\n2. order_number: The numerical order number without '#' (e.g. \"1001\"). If not provided, return null.\n\nRespond ONLY with valid JSON:\n{\"intent\": \"WISMO\", \"order_number\": \"1001\"}"
            },
            {
              "content": "={{ $json.body.body_text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
