        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a friendly, professional customer support agent for Sonic Store. \nWrite a concise, helpful email update to the customer about their order.\nInclude the order number, fulfillment status, carrier name, tracking number, and tracking link.\nKeep it natural and polite (under 4 sentences). Do not include placeholder text."
            },
            {
              "content": "={{\n  (() => {\n    const order = $json.data.orders.edges[0].node;\n    const tracking = order.fulfillments[0].trackingInfo[0];\n    return `Customer Name: Humayun\nOrder: ${order.name}\nStatus: ${order.displayFulfillmentStatus}\nCarrier: ${tracking.company}\nTracking Number: ${tracking.number}\nTracking URL: ${tracking.url}`;\n  })()\n}}"
            }
          ]
        },
